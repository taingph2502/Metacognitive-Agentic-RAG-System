# LLM provider: "deepseek" or "gemini"
LLM_PROVIDER=deepseek

# DeepSeek (default provider — OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (alternative provider — for comparison)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL
POSTGRES_USER=ara
POSTGRES_PASSWORD=ara_secret
POSTGRES_DB=ara_db
DATABASE_URL=postgresql+asyncpg://ara:ara_secret@localhost:5432/ara_db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=research_papers

# ElasticSearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=research_chunks

# Embedding & Reranker (HuggingFace model IDs)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# HF TOKEN
HF_TOKEN=your_hf_token_here

# Self-improvement thresholds
FAITHFULNESS_THRESHOLD=0.7
LAMBDA_COST=0.3
LAMBDA_LATENCY=0.1

# Constraints
MAX_LATENCY_SECONDS=15.0
