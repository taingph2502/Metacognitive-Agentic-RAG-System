# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=research_papers

# ElasticSearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=research_chunks

# Embedding (HuggingFace model ID)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# HF TOKEN
HF_TOKEN=your_hf_token_here

# Paper-like MetaRAG settings
RETRIEVAL_TOP_K=5
MONITOR_SIMILARITY_THRESHOLD=0.4
MAX_METACOGNITIVE_ROUNDS=5
METACOGNITIVE_CONVERGENCE_THRESHOLD=0.85
